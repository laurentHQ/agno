# Required API Key
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Alternative AI Models (choose one or more)
# OpenAI API (for GPT-4 model choice)
OPENAI_API_KEY=your_openai_api_key_here

# Optional API Keys for Enhanced Features
# Reddit API (for community discussions)
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=AgnoNewsAgent/1.0

# Tavily API (for AI-enhanced search)
TAVILY_API_KEY=your_tavily_api_key

# Google Search API (for comprehensive search results)
GOOGLE_API_KEY=your_google_api_key
GOOGLE_CSE_ID=your_google_custom_search_engine_id

# Brave Search API (for privacy-focused search)
BRAVE_API_KEY=your_brave_search_api_key

# Firecrawl API (for advanced web scraping)
FIRECRAWL_API_KEY=your_firecrawl_api_key

# News API (alternative news source)
NEWS_API_KEY=your_news_api_key

# Database Configuration
# For lightweight deployment, use SQLite (default)
SQLITE_DB_FILE=finance_agent.db

# For production deployment with PostgreSQL
# DATABASE_URL=postgresql://user:password@localhost:5432/finance_agent